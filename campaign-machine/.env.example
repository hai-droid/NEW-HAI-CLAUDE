# Copy this file to .env and fill in. Never commit .env, never paste it into a chat.

# --- Meta (Facebook / Instagram ads) ---
# A System User token from Business Manager with ads_management, ads_read, pages_read_engagement (see README).
META_ACCESS_TOKEN=
META_API_VERSION=v24.0

# --- Images for the creative agent ---
# none   = on-brand gradient backgrounds, free, no key
# openai = OpenAI image API (needs OPENAI_API_KEY)
# gemini = Google Gemini image API (needs GEMINI_API_KEY)
IMAGE_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model override, e.g. gpt-image-1 or gemini-2.5-flash-image
IMAGE_MODEL=
